# Dependencies and package-manager caches
/node_modules/
/.pnp
.pnp.*
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/
/.pnpm-store/

# Next.js build output
/.next/
/out/
/build/

# Tests and coverage
/coverage/
/playwright-report/
/test-results/

# Local environment and deployment settings
.env*
!.env.example
!.env.template
/.vercel/

# TypeScript and generated Next.js types
*.tsbuildinfo
/next-env.d.ts

# Logs and crash reports
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Local/editor and OS files
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
