# Use amazon.nova-micro-v1:0 in an in-region supported Bedrock region.
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_REGION=us-east-1
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ISSUER=rto-tracker-local
JWT_AUDIENCE=rto-assistant-services
JWT_PUBLIC_KEY_PATH=../spring-backend/.secrets/jwt-public.pem
SPRING_BACKEND_URL=http://localhost:8080

# For Singapore, use the APAC inference profile and source region instead:
# BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0
# AWS_REGION=ap-southeast-1
